# Z-Image Service Configuration

# Server settings
ZIMAGE_HOST=0.0.0.0
ZIMAGE_PORT=8080

# Model settings
ZIMAGE_MODEL_PATH=Tongyi-MAI/Z-Image-Turbo
ZIMAGE_CPU_OFFLOAD=true

# Image generation defaults
ZIMAGE_DEFAULT_WIDTH=2048
ZIMAGE_DEFAULT_HEIGHT=2048
ZIMAGE_DEFAULT_STEPS=9

# Storage paths (relative paths resolved from service directory)
# ZIMAGE_IMAGES_DIR=./images
# ZIMAGE_DATABASE_PATH=./data/images.db

# Rate limiting
ZIMAGE_RATE_LIMIT=10
ZIMAGE_RATE_LIMIT_WINDOW=60

# CORS (comma-separated origins, use * for all)
ZIMAGE_CORS_ORIGINS=*
